{
  "name": "nx-uml-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Architecture explorer for Nx workspaces with Angular enrichment",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:install": "node scripts/install-fixtures.mjs",
    "deps:check": "depcruise --config dependency-cruiser.config.mjs packages",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deps:check && pnpm test",
    "doctor": "node packages/cli/dist/bin.js doctor"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "dependency-cruiser": "^17.3.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
